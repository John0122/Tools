# 所有配置域名提供完整靶机页面；第一个域名用于从 IP 入口检测站外样例。
server {
    listen 8080;
    listen [::]:8080;
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name __LAB_EXTERNAL_HOSTS__;
    server_tokens off;
    # 外站入口与目录跳转不得暴露 8080/8443 容器端口。
    absolute_redirect off;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 64k;

    # 首页接口与分类页沿用同源路径，与 IP 入口保持相同的代理行为。
    location = /api { include /etc/nginx/proxy-api.conf; }
    location /api/ { include /etc/nginx/proxy-api.conf; }
    location = /healthz { include /etc/nginx/proxy-api.conf; }
    include /etc/nginx/lab-locations.conf;

    # 根路径直接提供首页；找不到的页面保留真实 404，供死链样例使用。
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }
}
